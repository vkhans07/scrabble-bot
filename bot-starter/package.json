{
  "name": "scrabblebot-bot-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "npm install --prefix ../spacetimedb && spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "build": "tsc",
    "build:native": "c++ -std=c++17 -O3 -pthread native/engine.cpp -o native/engine",
    "evaluate:logs": "node --import tsx src/evaluate-logs.ts"
  },
  "dependencies": {
    "spacetimedb": "^2.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
